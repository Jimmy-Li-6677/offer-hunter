{
  "manifest_version": 3,
  "name": "Claude Browser Bridge",
  "version": "0.2.0",
  "description": "Lets your local Claude Code MCP server control this Chrome (click, type, select, upload) on sites you allow.",
  "permissions": [
    "debugger",
    "tabs",
    "storage",
    "alarms",
    "tabGroups",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Claude Browser Bridge",
    "default_popup": "options.html"
  },
  "options_page": "options.html"
}
