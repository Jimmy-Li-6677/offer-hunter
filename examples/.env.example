# Copy to private\.env and fill in. Never commit or share the real .env (private\ is gitignored).
# Referenced as ${NAME} in JobSearch\CLAUDE.md and private\job-search-config.json; loaded by StartJobSearch.exe.
# No passwords: Claude never types them.
# Quote answers with "..." (or '...' if the answer contains double quotes).
APPLICANT_EMAIL=
APPLICANT_PHONE=
APPLICANT_STREET=
APPLICANT_CITY_STATE_ZIP=
APPLICANT_LINKEDIN_URL=
APPLICANT_PORTFOLIO_URL=

# Site accounts (usernames only)
GOOGLE_CAREERS_ACCOUNT=

# Companies to never apply to (current/past employers on the resume), comma-separated
SKIP_COMPANIES=""

# Claude Browser Bridge (generated on first server start if empty; paste into the Chrome extension)
BRIDGE_TOKEN=
BRIDGE_PORT=8765

# ===== Application answer bank (moved from job-search-config.json 2026-10-13) =====
# Answer bank for application forms (answers.md -> JSON -> .env). Claude reads this before every application, only asks you about questions not covered here, then adds the new answer to the right section below (dated if useful).
# Format: comment line = the form question, next line = ANSWER_<SECTION>_<...>=answer.
# Contact answers (email/phone/address/LinkedIn/portfolio) are the APPLICANT_* keys above.

# --- contact ---
# Q: Name
ANSWER_CONTACT_NAME=""
# Q: Preferred first name
ANSWER_CONTACT_PREFERRED_FIRST_NAME=""

# --- eligibility ---
# Q: Legally authorized to work in US
ANSWER_ELIG_LEGALLY_AUTHORIZED_TO_WORK_IN_US=""
# Q: Require sponsorship now or in future
ANSWER_ELIG_REQUIRE_SPONSORSHIP_NOW_OR_IN_FUTURE=""
# Q: Security clearance
ANSWER_ELIG_SECURITY_CLEARANCE=""
# Q: Previously employed by the company
ANSWER_ELIG_PREVIOUSLY_EMPLOYED_BY_THE_COMPANY=""
# Q: Employee referral
ANSWER_ELIG_EMPLOYEE_REFERRAL=""
# Q: Notified current manager
ANSWER_ELIG_NOTIFIED_CURRENT_MANAGER=""
# Q: Willing to relocate
ANSWER_ELIG_WILLING_TO_RELOCATE=""
# Q: Hybrid/onsite
ANSWER_ELIG_HYBRID_ONSITE=""

# --- compensation ---
# Q: Desired salary
ANSWER_COMP_DESIRED_SALARY=""

# --- education ---
# Q: Degree
ANSWER_EDU_DEGREE=""

# --- experience ---
# Q: Current
ANSWER_EXP_CURRENT=""
# Q: Previous
ANSWER_EXP_PREVIOUS=""
# Q: Total professional experience
ANSWER_EXP_TOTAL_PROFESSIONAL_EXPERIENCE=""
# Q: Work experience "Role Description" fields (Workday etc.)
ANSWER_EXP_ROLE_DESCRIPTION=""

# --- voluntarySelfId ---
# Q: Gender
ANSWER_SELFID_GENDER=""
# Q: Hispanic/Latino
ANSWER_SELFID_HISPANIC_LATINO=""
# Q: Race
ANSWER_SELFID_RACE=""
# Q: Veteran
ANSWER_SELFID_VETERAN=""
# Q: Disability
ANSWER_SELFID_DISABILITY=""
# Q: Do you identify as transgender
ANSWER_SELFID_TRANSGENDER=""

# --- attestation ---
# Q: E-signature
ANSWER_ATTEST_E_SIGNATURE=""

# --- optionalExtrasSkip ---
# Q: Work Opportunity Tax Credit (WOTC) questionnaire
ANSWER_SKIP_WORK_OPPORTUNITY_TAX_CREDIT_WOTC_QUESTIONNAIRE=""
# Q: Job-board account upsells (e.g. ADP BrightJump)
ANSWER_SKIP_JOB_BOARD_ACCOUNT_UPSELLS_E_G=""
# Q: AI resume screening opt-out
ANSWER_SKIP_AI_RESUME_SCREENING_OPT_OUT=""

# --- openEndedTemplate ---
# Q: "Why this company?" / "Anything else?"
ANSWER_OPEN_WHY_THIS_COMPANY_ANYTHING_ELSE=""

# --- signIn ---
# Q: Verification codes, passwords, account creation
ANSWER_SIGNIN_VERIFICATION_CODES_PASSWORDS_ACCOUNT_CREATION=""
# Q: Account email on application sites
ANSWER_SIGNIN_ACCOUNT_EMAIL_ON_APPLICATION_SITES=""
# Q: Password  (describe how passwords are handled - NEVER put a real password in this file)
ANSWER_SIGNIN_PASSWORD=""

# --- miscFormFields ---
# Q: Prefix
ANSWER_MISC_PREFIX=""
# Q: Preferred contact method
ANSWER_MISC_PREFERRED_CONTACT_METHOD=""
# Q: How did you hear about us
ANSWER_MISC_HOW_DID_YOU_HEAR_ABOUT_US=""
# Q: Previous applications log
ANSWER_MISC_PREVIOUS_APPLICATIONS_LOG=""
# Q: Notice period / date available
ANSWER_MISC_NOTICE_PERIOD_DATE_AVAILABLE=""
# Q: Years of relevant experience
ANSWER_MISC_YEARS_OF_RELEVANT_EXPERIENCE=""
# Q: Desired career level
ANSWER_MISC_DESIRED_CAREER_LEVEL=""
# Q: Relocation preference states
ANSWER_MISC_RELOCATION_PREFERENCE_STATES=""
# Q: Highest education
ANSWER_MISC_HIGHEST_EDUCATION=""

# --- clearanceRules ---
# Q: _updated
ANSWER_CLEAR_UPDATED=""
# Q: Public Trust positions
ANSWER_CLEAR_PUBLIC_TRUST_POSITIONS=""
